# Per-install runtime state (created next to init.lua by MacroQuest's
# configDir at first run) - these are personal to each player and should
# never be committed:
LRA_pages.lua
LRA_settings.lua
killorder_pages.lua

# Design source files (large binaries, not needed to run the script) -
# keep these local, don't publish them
*.psd

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp
